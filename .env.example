# Required: Figma personal access token (scope: File content — Read-only)
# Create one at https://www.figma.com/developers/api#access-tokens
FIGMA_API_KEY=

# Optional: provider-specific tokens for reading/writing token catalogs.
# Only set the one(s) matching your Tokens Studio sync source.

# GitHub personal access token (repo read scope; repo write for commit_and_push)
# TOKENS_STUDIO_GITHUB_TOKEN=

# GitLab personal access token (read_api scope)
# TOKENS_STUDIO_GITLAB_TOKEN=

# Bitbucket app password (repository read scope)
# TOKENS_STUDIO_BITBUCKET_TOKEN=
# TOKENS_STUDIO_BITBUCKET_USERNAME=

# Azure DevOps personal access token (Code read scope)
# TOKENS_STUDIO_ADO_TOKEN=

# Tokens Studio SaaS API key
# TOKENS_STUDIO_API_KEY=

# Supernova design system token
# TOKENS_STUDIO_SUPERNOVA_KEY=

# JSONBin master key
# TOKENS_STUDIO_JSONBIN_KEY=

# Bearer token for plain URL provider
# TOKENS_STUDIO_URL_TOKEN=
